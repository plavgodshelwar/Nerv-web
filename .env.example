# NERV Multi-Agent Digital Office Configuration

# 1. Telegram Bot Token (from @BotFather on Telegram)
# Create a bot via @BotFather and paste the HTTP API token below:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Main API & Routing Keys (Optional: NERV has built-in offline judgment engine)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 3. Operational Defaults
DEFAULT_APPROVAL_THRESHOLD=50000.0
DEFAULT_MODE=auto
PORT=8000
